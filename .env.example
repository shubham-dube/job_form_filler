# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Master profile path (defaults to profile.md in current directory)
PROFILE_PATH=profile.md

# Optional: Session cookies for forms that enforce Google Sign-in (e.g., forms with file upload)
# Format: "SID=...; HSID=...; SSID=..."
GOOGLE_COOKIES=

# Whether to automatically open the generated pre-filled URL in your default browser
AUTO_OPEN_BROWSER=true
